# Datos (pesados y con rostros de personas: no se suben a GitHub)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Corridas del barrido: se versionan sus .json y .csv (evidencia); las figuras, los parámetros
# y las predicciones se regeneran con src.train / src.experimentos. finales/ y resumen/ se
# versionan completos.
results/experimentos/*/*.png
results/experimentos/*/parametros.npz
results/experimentos/*/predicciones.csv

# Carpetas temporales de tests/regresion.py
tests/_salida_temporal/

# Entorno virtual y caché de Python
.venv/
venv/
__pycache__/
*.pyc

# Jupyter / VS Code
.ipynb_checkpoints/
.vscode/

# Credenciales de Kaggle
kaggle.json
